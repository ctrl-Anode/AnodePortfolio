# =============================================================
# Server environment for HOST-RUN development (npm run dev).
# docker-compose.yml overrides network hostnames automatically.
# =============================================================

NODE_ENV=development
PORT=5000

APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=mysql://root:root@localhost:3306/app
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-32-chars-long
MFA_TOKEN_SECRET=change-me-dev-mfa-secret-at-least-32-chars-longxx
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

MEILI_ENABLED=true
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=dev-meili-master-key-minimum-16-chars

WORKER_MODE=inline

MAIL_DRIVER=log
MAIL_FROM="Acme Dev <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Single-container deployments: absolute path to the built SPA that the API
# serves. Leave unset in development (the Vite dev server serves the client).
CLIENT_DIST_PATH=
# Container entrypoint only: run `prisma db seed` (idempotent) after migrations.
RUN_SEED=false
FIREBASE_STORAGE_BUCKET=

# Cloudflare R2 (STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

PROD_CSP=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
# Recipient for the contact-form notification email (falls back to ADMIN_EMAIL)
CONTACT_NOTIFY_EMAIL=you@example.com
# GitHub auto-sync: username enables the "Sync from GitHub" flow (+ auto-seed on empty)
GITHUB_USERNAME=your-github-username
# Optional personal access token (higher API rate limits). Public repos work without it.
GITHUB_TOKEN=
